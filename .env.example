# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is never committed. Real keys must never go in any other file.
#
# Nothing below is needed yet. These are the accounts still to be created.

# The public web address of the site. Used for social share images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (database and member login) -- not yet created ---------------
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""   # server only, never expose to the browser

# --- HubSpot (marketing records) -- not yet created ------------------------
# HUBSPOT_ACCESS_TOKEN=""

# --- Resend (sending emails) -- not yet created ----------------------------
# RESEND_API_KEY=""
# The address emails come from. Must be on a domain verified in Resend.
# EMAIL_FROM="fwd. <hello@yourdomain>"

# --- Signing links ---------------------------------------------------------
# Any long random string. It signs unsubscribe links so they cannot be edited
# to unsubscribe somebody else. Generate one with: openssl rand -base64 32
# LINK_SECRET=""

# --- Admin -----------------------------------------------------------------
# The shared password for /admin, where applications are accepted or declined.
# Temporary: replaced by proper sign in when The Clubhouse is built.
# If left unset, /admin does not exist.
# ADMIN_PASSWORD=""

# --- Early access ----------------------------------------------------------
# Lets the club team preview the real site while the holding page is up.
# Pick any phrase. If this is left unset, the early access page does not exist,
# so there is no default password for anyone to guess.
# EARLY_ACCESS_PASSWORD=""
