/**
 * Joins supabase/migrations/*.sql into supabase/all-migrations.sql, so the six
 * files can be run as one paste in the Supabase SQL editor rather than six.
 *
 * Run it with: npm run build:sql
 *
 * The combined file is generated and checked in, so somebody setting the
 * database up does not have to run anything first. Re-run this after changing
 * any migration, and `npm run check:db` verifies that the combined file builds
 * the same database as the six separate ones.
 */

import { readdir, readFile, writeFile } from "node:fs/promises";
import path from "node:path";

const DIR = path.join(process.cwd(), "supabase", "migrations");
const OUT = path.join(process.cwd(), "supabase", "all-migrations.sql");

const HEADER = `/* ===========================================================================
   fwd. — the whole database, in one file
   ---------------------------------------------------------------------------
   GENERATED. Do not edit this file. It is the numbered files in
   supabase/migrations joined in order, so they can be run as a single paste.

   Note for whoever edits this header: Postgres nests block comments, so the
   two characters that open one must not appear inside it. Writing a path with
   a star in it here opens a comment that never closes and the whole file
   fails to run. check:db catches that, but it is easier not to do it.

   To rebuild it after changing a migration:  npm run build:sql

   HOW TO USE IT
   In Supabase, open SQL Editor, paste this whole file, press Run. It should
   say "Success. No rows returned".

   Postgres runs a pasted batch as one transaction, so if anything in here
   fails, nothing is applied at all. That is deliberate: a half-built database
   is worse than an empty one, because the failure shows up weeks later as one
   page not working rather than now as an error message.

   Running it twice is safe. Every statement is written to do nothing if the
   thing already exists.
   =========================================================================== */

`;

const files = (await readdir(DIR)).filter((f) => f.endsWith(".sql")).sort();

const parts = [HEADER];
for (const file of files) {
  const sql = await readFile(path.join(DIR, file), "utf8");
  parts.push(
    `\n/* ---------------------------------------------------------------------------\n   ${file}\n   --------------------------------------------------------------------------- */\n\n`,
  );
  parts.push(sql.trimEnd() + "\n");
}

await writeFile(OUT, parts.join(""));
console.log(`Wrote supabase/all-migrations.sql from ${files.length} migrations.`);
